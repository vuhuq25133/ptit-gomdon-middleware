# ==============================================================================
# HỆ THỐNG GOM ĐƠN ĐA NỀN TẢNG (ORDER CONSOLIDATION MIDDLEWARE)
# FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (COMMIT LÊN GIT)
# ==============================================================================

# 1. Cấu hình Ứng dụng Backend
APP_NAME="Gom Don Da Nen Tang"
APP_ENV="development"
APP_PORT=8000
DEBUG=True

# 2. Cơ sở dữ liệu PostgreSQL (Kho Lakehouse 2 tầng Bronze/Silver)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=StrongPassword@2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gomdon_lakehouse
DATABASE_URL=postgresql+asyncpg://postgres:StrongPassword@2026@localhost:5432/gomdon_lakehouse

# 3. Redis (Khóa chống trùng Dedup SETNX & Cache Token)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=RedisPass@2026
REDIS_URL=redis://:RedisPass@2026@localhost:6379/0

# 4. RabbitMQ (Message Broker AMQP Doanh nghiệp)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=RabbitAdmin@2026
RABBITMQ_URL=amqp://admin:RabbitAdmin@2026@localhost:5672/

# 5. Đường hầm Internet Webhook (Dán link Cloudflare Tunnel vào đây)
WEBHOOK_BASE_URL=https://your-tunnel-url.trycloudflare.com

# 6. Đối tác ShopTrack API (Hiện tại trỏ vào Mock Server chạy ở port 8001)
SHOPTRACK_API_BASE_URL=http://localhost:8001/api/v1
SHOPTRACK_API_KEY=mock_shoptrack_api_key_2026

# 7. Mã bí mật xác thực Webhook Meta (Facebook) & Zalo
META_VERIFY_TOKEN=ptit_webhook_secret_token_2026
ZALO_OA_SECRET_KEY=zalo_oa_mock_secret_2026
